type
  arr=array[0..100]of integer;
var
  i,j,k,p,m,t,n:longint;
  f:array[0..50,-5000..5000]of arr;
procedure plus(var a,b:arr);
var i:longint;
begin
  a[0]:=max(a[0],b[0]);
  for i:=1 to a[0]do
  begin
    a[i]:=a[i]+b[i];
    a[i+1]:=a[i+1]+a[i]div 10;
    a[i]:=a[i]mod 10;
  end;
  if a[a[0]+1]>0 then inc(a[0]);
end;
begin
  assign(input,'floor.in');reset(input);
  assign(output,'floor.out');rewrite(output);
  readln(n,m); if m>n then begin t:=m;m:=n;n:=t; end;
  m:=1 shl m-1;
  for i:=1 to 233 do begin f[1,ss[i],1]:=1;f[1,ss[i],0]:=1; end;
  for i:=2 to n do
    for j:=0 to m do
      for k:=1 to 233 do
        if ss[k]>j then break else
        if ss[k]and(j-ss[k])=0 then
          plus(f[i,j],f[i-1,m-j+ss[k]]);
  for i:=f[n,m,0]downto 1 do write(f[n,m,i]);
  writeln;
  close(input); close(output);
end.